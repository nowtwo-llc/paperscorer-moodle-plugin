# PHP for the Moodle container. 8.4 is the ceiling: Moodle's locked
# dependencies (ezyang/htmlpurifier, openspout/openspout) refuse 8.5, so
# PHPUnit cannot be installed above 8.4. Moodle 4.x additionally blocks 8.4+
# via restrict_php_version_84, so it needs 8.3.
PHP_VERSION=8.3

# Which Moodle the ps-moodle stack runs against.
#
# Moodle 4.5 LTS (serves from the tree root, PHP 8.3 max):
MOODLE_SRC=../moodle-instance
MOODLE_PLUGIN_PATH=/var/www/html/local/paperscorer
APACHE_DOCUMENT_ROOT=/var/www/html

# Moodle 5.x (serves from public/, PHP 8.4):
# PHP_VERSION=8.4
# MOODLE_SRC=../moodle-instance-52
# MOODLE_PLUGIN_PATH=/var/www/html/public/local/paperscorer
# APACHE_DOCUMENT_ROOT=/var/www/html/public
